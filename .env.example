# =============================================================================
# GOOGOL VIBE CONFIGURATION
# =============================================================================
# Copy this file to .env and configure as needed.
# All paths support ~ for home directory expansion.
# Most settings have sensible defaults and are optional.

# =============================================================================
# CREDENTIAL PATHS (Optional - auto-detected if empty)
# =============================================================================

# Directory for all Googol Vibe configuration
# Default: ~/.googol-vibe
# GOOGOL_VIBE_CONFIG_DIR=~/.googol-vibe

# Path to OAuth credentials.json from GCP Console
# Default: $GOOGOL_VIBE_CONFIG_DIR/credentials.json
# GOOGLE_CREDS_PATH=~/.googol-vibe/credentials.json

# Directory for OAuth tokens
# Default: $GOOGOL_VIBE_CONFIG_DIR/tokens
# GOOGLE_TOKEN_DIR=~/.googol-vibe/tokens

# =============================================================================
# SERVER PORTS (Optional)
# =============================================================================

# OAuth callback port. Leave it unset: sign-in then uses a free port on
# 127.0.0.1, which a Desktop OAuth client accepts. Set it only to pin the port,
# for example for a Web client registered with a fixed redirect URI
# (Web clients default to http://localhost:3000/oauth2callback).
# OAUTH_CALLBACK_PORT=

# Vite dev server port
# Default: 9000
# VITE_PORT=9000

# Flask backend port (web-only mode)
# Default: 5000
# FLASK_PORT=5000

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Environment: development | production
# Default: development
# NODE_ENV=development

# =============================================================================
# MCP SERVER CONFIGURATION (For AI agent integration)
# =============================================================================

# Only needed if using gmail-mcp or calendar-mcp outside Electron
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# =============================================================================
# SENTRY ERROR REPORTING (Optional)
# =============================================================================

# Sentry DSN for opt-in error reporting
# SENTRY_DSN=https://xxx@sentry.io/xxx
